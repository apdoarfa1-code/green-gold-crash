# Application Settings
APP_NAME="Green Gold Crash Engine"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="green_gold"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_postgres_password"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# InfluxDB Configuration
INFLUX_URL="http://localhost:8086"
INFLUX_TOKEN="your_influx_super_secret_token"
INFLUX_ORG="green-gold"
INFLUX_BUCKET="crash_rounds"

# API & Monitoring
API_HOST="0.0.0.0"
API_PORT=8000
PROMETHEUS_PORT=9090

# Data Collection & Proxies
PROXIES=["http://proxy1.example.com:8080", "http://proxy2.example.com:8080"]
USER_AGENTS=["Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"]
TARGET_URL="https://example.com/aviator"
